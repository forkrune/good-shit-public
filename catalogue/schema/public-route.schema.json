{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://good-shit.local/schema/public-route.schema.json",
  "title": "Good Shit public generic route",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "journeyKind", "nearbyAsset", "variants"],
  "properties": {
    "mode": { "enum": ["drive", "cycle", "rail", "ferry", "walk", "mixed"] },
    "journeyKind": { "enum": ["point-to-point", "loop", "corridor"] },
    "discoveryCorridorKm": { "type": "number", "minimum": 2, "maximum": 25 },
    "preferredVariantId": { "type": "string" },
    "nearbyAsset": { "type": "string", "pattern": "^data/routes/[0-9a-f-]+/nearby\\.json$" },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "lifecycle", "geometrySemantics", "navigationGrade", "direction", "routeAsset"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "lifecycle": { "enum": ["active", "seasonal", "planned"] },
          "geometrySemantics": { "enum": ["route-centerline", "representative-corridor"] },
          "navigationGrade": { "const": false },
          "distanceKm": { "type": "number", "exclusiveMinimum": 0 },
          "usefulDurationMinutes": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "max", "basis"],
            "properties": {
              "min": { "type": "number", "exclusiveMinimum": 0 },
              "max": { "type": "number", "exclusiveMinimum": 0 },
              "basis": { "enum": ["editorial", "operator", "mixed"] }
            }
          },
          "direction": { "enum": ["either", "forward", "reverse"] },
          "routeAsset": { "type": "string", "pattern": "^data/routes/[0-9a-f-]+/[a-z0-9-]+\\.json$" }
        }
      }
    }
  }
}
