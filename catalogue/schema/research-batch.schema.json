{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://good-shit.local/schema/research-batch.schema.json",
  "title": "Good Shit research ingestion batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "batchId",
    "generatedAt",
    "entities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "batchId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "researchPrompt": {
      "type": [
        "string",
        "null"
      ]
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "entity.schema.json"
      }
    }
  }
}
