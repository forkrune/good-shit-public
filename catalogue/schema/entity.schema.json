{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://good-shit.local/schema/entity.schema.json",
  "title": "Good Shit canonical catalogue entity",
  "description": "Stable canonical entity envelope. Namespace-specific custom.values are validated against catalogue/config/custom-metadata.json by the semantic validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentVersion",
    "id",
    "slug",
    "entityType",
    "names",
    "summary",
    "description",
    "whyWorthwhile",
    "location",
    "categories",
    "tags",
    "tier",
    "editorial",
    "geometry",
    "links",
    "externalRatings",
    "research",
    "custom"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contentVersion": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "format": "uuid" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "entityType": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "names": { "$ref": "#/$defs/names" },
    "summary": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "whyWorthwhile": { "type": "string", "minLength": 1 },
    "location": { "$ref": "#/$defs/location" },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "uniqueItems": true
    },
    "subcategories": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "tier": { "enum": ["S", "A", "B", "C", "D", "E", "F", "unranked"] },
    "editorial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "recommendation", "qualityRationale", "lastReviewedAt"],
      "properties": {
        "status": { "enum": ["candidate", "published", "needs-review", "rejected", "deprecated", "closed"] },
        "recommendation": { "enum": ["publish", "review", "reject", "unpublish"] },
        "qualityRationale": { "type": "string", "minLength": 1 },
        "publishedAt": { "type": ["string", "null"], "format": "date-time" },
        "lastReviewedAt": { "type": "string", "format": "date-time" },
        "replacedById": { "type": ["string", "null"], "format": "uuid" }
      }
    },
    "geometry": { "$ref": "#/$defs/geometry" },
    "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "externalRatings": { "type": "array", "items": { "$ref": "#/$defs/externalRating" } },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firstResearchedAt", "lastVerifiedAt", "confidence", "sources"],
      "properties": {
        "firstResearchedAt": { "type": "string", "format": "date-time" },
        "lastVerifiedAt": { "type": "string", "format": "date-time" },
        "confidence": { "enum": ["low", "medium", "high"] },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/researchSource" } },
        "notes": { "type": ["string", "null"] }
      }
    },
    "custom": { "$ref": "#/$defs/customEnvelope" },
    "images": { "type": "array", "items": { "$ref": "#/$defs/imageReference" } },
    "demo": { "type": "boolean" }
  },
  "$defs": {
    "names": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical"],
      "properties": {
        "canonical": { "type": "string", "minLength": 1 },
        "local": { "type": ["string", "null"] },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "transliterations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["countryCode", "country"],
      "properties": {
        "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "country": { "type": "string", "minLength": 1 },
        "region": { "type": ["string", "null"] },
        "locality": { "type": ["string", "null"] },
        "address": { "type": ["string", "null"] }
      }
    },
    "position": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "ring": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/position" }
    },
    "geometry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": { "type": { "const": "Point" }, "coordinates": { "$ref": "#/$defs/position" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": { "type": { "const": "MultiPoint" }, "coordinates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/position" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": { "type": { "const": "LineString" }, "coordinates": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/position" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "MultiLineString" },
            "coordinates": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/position" } } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": { "type": { "const": "Polygon" }, "coordinates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ring" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "MultiPolygon" },
            "coordinates": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ring" } } }
          }
        }
      ]
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "label"],
      "properties": {
        "kind": { "enum": ["official", "google-maps", "openstreetmap", "reservation", "trail-source", "research", "other"] },
        "url": { "type": "string", "format": "uri" },
        "label": { "type": "string", "minLength": 1 },
        "providerId": { "type": ["string", "null"] }
      }
    },
    "externalRating": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "rating", "scale", "reviewCount", "observedAt", "sourceUrl"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "rating": { "type": "number", "minimum": 0 },
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "reviewCount": { "type": "integer", "minimum": 0 },
        "observedAt": { "type": "string", "format": "date-time" },
        "sourceUrl": { "type": "string", "format": "uri" },
        "providerReference": { "type": ["string", "null"] }
      }
    },
    "researchSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "accessedAt"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "accessedAt": { "type": "string", "format": "date-time" },
        "note": { "type": ["string", "null"] }
      }
    },
    "customEnvelope": {
      "description": "Namespace-specific fields in values are validated by custom-metadata.json and the semantic validator.",
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "schemaVersion", "values"],
      "properties": {
        "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "values": { "type": "object" }
      }
    },
    "imageReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "role", "alt"],
      "properties": {
        "assetId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "role": { "enum": ["cover", "gallery"] },
        "alt": { "type": "string", "minLength": 1, "maxLength": 300 },
        "caption": { "type": ["string", "null"], "maxLength": 500 }
      }
    }
  }
}
