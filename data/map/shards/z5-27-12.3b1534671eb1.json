ticipatory searing"],"tier":"S","geometryType":"Point","centroid":[133.236532,33.321461],"bbox":[133.236532,33.321461,133.236532,33.321461],"customNamespace":"food","customFacets":{"food.primaryCategory":"Seafood & Fishing-Port Food","food.japanRegion":"Shikoku","food.value":"good","food.reservationClass":"recommended","food.englishAccess":"B","food.localRecognition":"High","food.japaneseSpecialistRecognition":"High","food.internationalRecognition":"Medium"},"cardSignals":["Seafood & Fishing Port Food","English B","Reservation: recommended"],"latestExternalRating":null,"coverImage":null,"demo":false},{"id":"83b2a6bc-4d58-5796-82e3-205dc7bedbbe","slug":"jigoku-mushi-kobo-kannawa","name":"Jigoku Mushi Kobo Kannawa","localName":"地獄蒸し工房 鉄輪","summary":"The visitor performs a real local cooking technique using the same geothermal system that structures Kannawa's bath and domestic culture.","whyWorthwhile":"Its strongest decision-relevant feature is access to Cooking ingredients in naturally hot geothermal steam. The recommended visit is: Buy a balanced basket including vegetables and one protein, then compare how steam changes sweetness and texture.","entityType":"food","countryCode":"JP","country":"Japan","region":"Oita","locality":"Beppu","categories":["food-drink","food-experience-workshop"],"subcategories":["food-experience-workshop"],"tags":["geothermal steam","self-cooking","onsen town"],"tier":"A","geometryType":"Point","centroid":[131.476211,33.315429],"bbox":[131.476211,33.315429,131.476211,33.315429],"customNamespace":"food","customFacets":{"food.primaryCategory":"Food Experience / Workshop","food.japanRegion":"Kyushu","food.value":"exceptional","food.reservationClass":"walk-in","food.englishAccess":"A","food.localRecognition":"High","food.japaneseSpecialistRecognition":"High","food.internationalRecognition":"Low"},"cardSignals":["Food Experience / Workshop","English A","Reservation: walk in"],"latestExternalRating":null,"coverImage":null,"demo":false},{"id":"87